---
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="hero-texto">
    <p class="hero-etiqueta">2.º año de secundaria</p>
    <h1>Estadística y Probabilidad</h1>
    <p class="hero-descripcion">
      Consultá, aprendé, repasá y practicá con lecciones, ejercicios con corrección automática y
      actividades interactivas.
    </p>
    <div class="hero-botones">
      <a class="boton-primario" href={`${base}practica/`}>Empezar a practicar</a>
      <a class="boton-secundario" href={`${base}lecciones/`}>Ver lecciones</a>
    </div>
  </div>

  <svg class="hero-icono" viewBox="0 0 120 120" role="img" aria-hidden="true">
    <rect x="10" y="70" width="18" height="40" rx="3" style="fill: var(--color-acento)" />
    <rect x="36" y="50" width="18" height="60" rx="3" style="fill: var(--color-ok)" />
    <rect x="62" y="30" width="18" height="80" rx="3" style="fill: var(--color-error)" />
    <rect x="88" y="58" width="18" height="52" rx="3" style="fill: var(--color-tinta-suave)" />
  </svg>
</section>
