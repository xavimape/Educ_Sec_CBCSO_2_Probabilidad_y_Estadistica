---
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="hero-texto">
    <p class="hero-etiqueta">2.º año de secundaria</p>
    <h1>Estadística y Probabilidad</h1>
    <p class="hero-descripcion">
      Consultá, aprendé, repasá y practicá con lecciones, ejercicios con corrección automática y
      actividades interactivas.
    </p>
    <div class="hero-botones">
      <a class="boton-primario" href={`${base}practica/`}>Empezar a practicar</a>
      <a class="boton-secundario" href={`${base}lecciones/`}>Ver lecciones</a>
    </div>
  </div>

  <img
    class="hero-icono"
    src={`${base}ilustraciones/diana-objetivo.png`}
    alt="Ilustración de una diana con una flecha en el centro, que representa el objetivo de aprendizaje."
    width="120"
    height="120"
  />
</section>
