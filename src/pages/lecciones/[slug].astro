---
import Layout from '../../layouts/Layout.astro';
import Migas from '../../components/Migas.astro';
import { getCollection, render } from 'astro:content';
import GraficoCircular from '../../components/GraficoCircular.tsx';
import Histograma from '../../components/Histograma.tsx';
import ArbolNodos from '../../components/ArbolNodos.tsx';
import AlertaConcepto from '../../components/AlertaConcepto.tsx';
import PasosConstruccion from '../../components/PasosConstruccion.tsx';
import Comparativa from '../../components/Comparativa.tsx';
import '../../styles/actividades.css';
import '../../styles/kit.css';

export async function getStaticPaths() {
  const lecciones = await getCollection('lecciones');
  return lecciones.map((leccion) => ({ params: { slug: leccion.id }, props: { leccion } }));
}

const { leccion } = Astro.props;
const { Content } = await render(leccion);
const base = import.meta.env.BASE_URL;
const conGrafico = ['m2-tablas-de-frecuencias', 'm3-graficos', 'm7-probabilidad'].includes(leccion.id);
---

<Layout titulo={leccion.data.titulo} descripcion={leccion.data.objetivo}>
  <main>
    <Migas items={[{ texto: 'Inicio', href: base }, { texto: 'Lecciones', href: `${base}lecciones/` }, { texto: leccion.data.titulo }]} />
    <p><a href="../">← Volver a las lecciones</a></p>
    <div class="leccion-contenido">
      <h1>{leccion.data.titulo}</h1>
      <p><strong>Módulo {leccion.data.modulo} · Objetivo:</strong> {leccion.data.objetivo}</p>
      {leccion.id === 'm7-probabilidad' && (
        <img
          class="leccion-ilustracion"
          src={`${base}ilustraciones/dado-probabilidad.png`}
          alt="Ilustración de un dado, que representa los experimentos aleatorios."
          width="120"
          height="120"
        />
      )}
      {leccion.id === 'm8-comunicacion' && (
        <img
          class="leccion-ilustracion"
          src={`${base}ilustraciones/lupa-analisis.png`}
          alt="Ilustración de una lupa, que representa la lectura crítica de datos."
          width="120"
          height="120"
        />
      )}
      <Content />

      {leccion.id === 'm1-dato-y-variable' && (
        <section class="bloque-kit">
          <h2>Para tener en cuenta</h2>
          <AlertaConcepto
            client:load
            titulo="¡OJO!"
            texto="Un número de camiseta es una etiqueta (Nominal), NO una cantidad. Ver un número no alcanza para clasificar."
          />
        </section>
      )}

      {leccion.id === 'm3-graficos' && (
        <section class="bloque-kit">
          <h2>Cómo se construye, paso a paso</h2>
          <PasosConstruccion
            client:load
            pasos={[
              'Trazá los ejes: horizontal para las categorías, vertical para la frecuencia.',
              'Graduá el eje vertical con una escala uniforme.',
              'Marcá la cuadrícula (2 cuadritos de ancho y 1 de separación).',
              'Levantá cada barra hasta su frecuencia y rotulá los dos ejes.',
            ]}
            diagramas={['ejes', 'graduacion', 'cuadricula', 'barras']}
          />
        </section>
      )}

      {leccion.id === 'm5-eleccion-de-medida' && (
        <section class="bloque-kit">
          <h2>¿Media o mediana?</h2>
          <Comparativa
            client:load
            error="Usar la media para representar un valor típico cuando hay valores extremos."
            acierto="Usar la mediana para representar un valor típico cuando hay valores extremos."
            explicacion="La mediana no se deja arrastrar por un dato extremo; la media sí. Pero la media es útil si querés calcular el total repartido equitativamente."
          />
        </section>
      )}

      {conGrafico && (
        <section class="bloque-grafico">
          <h2>Practicá con el gráfico</h2>
          {leccion.id === 'm2-tablas-de-frecuencias' && <GraficoCircular client:load />}
          {leccion.id === 'm3-graficos' && <Histograma client:load />}
          {leccion.id === 'm7-probabilidad' && <ArbolNodos client:load />}
          <p>
            <a href={`${base}actividades/graficos/`}>Ver la actividad completa de gráficos interactivos</a>.
          </p>
        </section>
      )}
    </div>
  </main>
</Layout>
