---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const lecciones = (await getCollection('lecciones')).sort((a, b) => a.data.orden - b.data.orden);
const base = import.meta.env.BASE_URL;
---

<Layout
  titulo="Lecciones"
  descripcion="Lecciones de Estadística y Probabilidad para segundo año."
>
  <main>
    <h1>Lecciones</h1>
    {lecciones.length === 0 ? (
      <p>Todavía no hay lecciones publicadas.</p>
    ) : (
      <ul class="tarjetas">
        {lecciones.map((leccion) => (
          <li class="tarjeta">
            <a href={`./${leccion.id}/`}>
              <span class="tarjeta-modulo">{leccion.data.modulo}</span>
              <strong>{leccion.data.titulo}</strong>
              <p>{leccion.data.objetivo}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
    <p><a href={base}>Volver al inicio</a>.</p>
  </main>
</Layout>
