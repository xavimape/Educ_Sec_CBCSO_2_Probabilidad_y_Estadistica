---
import Layout from '../../layouts/Layout.astro';
import ArbolProbabilidad from '../../components/ArbolProbabilidad.tsx';
import '../../styles/actividades.css';

const base = import.meta.env.BASE_URL;
---

<Layout
  titulo="Actividad · Árbol de probabilidad"
  descripcion="Construí el espacio muestral y calculá una probabilidad."
>
  <main>
    <h1>Construí el árbol de probabilidad</h1>
    <ArbolProbabilidad client:load />
    <p><a href={base}>Volver al inicio</a>.</p>
  </main>
</Layout>
