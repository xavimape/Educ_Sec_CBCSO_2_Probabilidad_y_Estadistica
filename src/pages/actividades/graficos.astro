---
import Layout from '../../layouts/Layout.astro';
import GraficoCircular from '../../components/GraficoCircular.tsx';
import Histograma from '../../components/Histograma.tsx';
import ArbolNodos from '../../components/ArbolNodos.tsx';
import '../../styles/actividades.css';

const base = import.meta.env.BASE_URL;
---

<Layout
  titulo="Gráficos interactivos"
  descripcion="Circular, histograma y árbol de probabilidad."
>
  <main>
    <p><a href={base}>← Volver al inicio</a></p>
    <h1>Gráficos interactivos</h1>
    <p>Vista previa de los gráficos SVG de la Fase 6B: circular (M2), histograma (M3) y árbol de probabilidad (M7).</p>

    <h2>Circular (M2)</h2>
    <GraficoCircular client:load />

    <h2>Histograma (M3)</h2>
    <Histograma client:load />

    <h2>Árbol de probabilidad (M7)</h2>
    <ArbolNodos client:load />
  </main>
</Layout>
