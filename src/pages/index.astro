---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

const modulos = [
  { modulo: 'M1', titulo: 'Dato y variable', slug: 'm1-dato-y-variable' },
  { modulo: 'M2', titulo: 'Tablas de frecuencias', slug: 'm2-tablas-de-frecuencias' },
  { modulo: 'M3', titulo: 'Gráficos', slug: 'm3-graficos' },
  { modulo: 'M4', titulo: 'Medidas de tendencia central', slug: 'm4-medidas' },
  { modulo: 'M5', titulo: 'Elección de la medida', slug: 'm5-eleccion-de-medida' },
  { modulo: 'M6', titulo: 'Azar y espacio muestral', slug: 'm6-azar' },
  { modulo: 'M7', titulo: 'Conteo y probabilidad', slug: 'm7-probabilidad' },
  { modulo: 'M8', titulo: 'Comunicación y lectura crítica', slug: 'm8-comunicacion' },
];

const base = import.meta.env.BASE_URL;

const fichas = [
  { archivo: 'ficha-01-variables.png', titulo: 'Ficha 1: Variables' },
  { archivo: 'ficha-02-frecuencia-absoluta.png', titulo: 'Ficha 2: Frecuencia absoluta' },
  { archivo: 'ficha-03-frecuencia-relativa-porcentaje.png', titulo: 'Ficha 3: Frecuencia relativa y porcentaje' },
  { archivo: 'ficha-04-frecuencia-acumulada.png', titulo: 'Ficha 4: Frecuencia acumulada' },
  { archivo: 'ficha-05-grafico-de-barras.png', titulo: 'Ficha 5: Gráfico de barras' },
  { archivo: 'ficha-06-media.png', titulo: 'Ficha 6: Media' },
  { archivo: 'ficha-07-mediana.png', titulo: 'Ficha 7: Mediana' },
  { archivo: 'ficha-08-moda.png', titulo: 'Ficha 8: Moda' },
  { archivo: 'ficha-09-elegir-la-medida.png', titulo: 'Ficha 9: Elegir la medida' },
  { archivo: 'ficha-10-simbolos.png', titulo: 'Ficha 10: Símbolos' },
];
---

<Layout
  titulo="Estadística y Probabilidad · 2.º año"
  descripcion="Consultá, aprendé, repasá y practicá Estadística y Probabilidad para el segundo año de secundaria."
>
  <main>
    <Hero />

    <h2>Contenido</h2>
    <ul class="tarjetas">
      {modulos.map((m) => (
        <li class="tarjeta">
          <a href={`./lecciones/${m.slug}/`}>
            <img class="tarjeta-icono" src={`${base}ilustraciones/libro-lecciones.png`} alt="" aria-hidden="true" width="48" height="48" />
            <span class="tarjeta-modulo">{m.modulo}</span>
            <span class="tarjeta-titulo">{m.titulo}</span>
            <span class="tarjeta-ir">Ver lección →</span>
          </a>
        </li>
      ))}
    </ul>
    <p><a href="./lecciones/">Ver las lecciones disponibles</a>.</p>

    <h2>¿Qué querés hacer hoy?</h2>
    <ul class="tarjetas">
      <li class="tarjeta">
        <a href="./practica/">
          <img class="tarjeta-icono" src={`${base}ilustraciones/calculadora-practica.png`} alt="" aria-hidden="true" width="48" height="48" />
          <span class="tarjeta-titulo">Practicar</span>
          <span class="tarjeta-desc">Ejercicios con corrección automática.</span>
          <span class="tarjeta-ir">Ir →</span>
        </a>
      </li>
      <li class="tarjeta">
        <a href="./laboratorio/">
          <img class="tarjeta-icono" src={`${base}ilustraciones/matraz-laboratorio.png`} alt="" aria-hidden="true" width="48" height="48" />
          <span class="tarjeta-titulo">Laboratorio</span>
          <span class="tarjeta-desc">Explorá datos y medidas.</span>
          <span class="tarjeta-ir">Ir →</span>
        </a>
      </li>
      <li class="tarjeta">
        <a href="./simulacro/">
          <img class="tarjeta-icono" src={`${base}ilustraciones/documento-simulacro.png`} alt="" aria-hidden="true" width="48" height="48" />
          <span class="tarjeta-titulo">Simulacro</span>
          <span class="tarjeta-desc">Practicá con un repaso mixto.</span>
          <span class="tarjeta-ir">Ir →</span>
        </a>
      </li>
    </ul>

    <h2>Actividades interactivas</h2>
    <ul>
      <li><a href="./actividades/barras/">Construir un gráfico de barras</a></li>
      <li><a href="./actividades/arbol/">Construir un árbol de probabilidad</a></li>
      <li><a href="./actividades/graficos/">Gráficos interactivos (circular, histograma y árbol)</a></li>
    </ul>

    <h2>Recursos y descargas</h2>
    <ul>
      <li>
        <a href={`${base}documentos/guia-estudio-estadistica-2do-anio.pdf`} download>
          Guía de estudio completa (PDF para imprimir o descargar)
        </a>
      </li>
      <li>
        <strong>Fichas didácticas de apoyo (imágenes para celular):</strong>
        <ul>
          {fichas.map((f) => (
            <li>
              <a href={`${base}fichas/${f.archivo}`} target="_blank" rel="noopener">
                {f.titulo}
              </a>
            </li>
          ))}
        </ul>
      </li>
    </ul>
  </main>
</Layout>
