---
import Layout from '../layouts/Layout.astro';
import Migas from '../components/Migas.astro';
import Laboratorio from '../components/Laboratorio.tsx';
import '../styles/laboratorio.css';

const base = import.meta.env.BASE_URL;
---

<Layout titulo="Laboratorio" descripcion="Explorá datos, tabla, gráfico y medidas de tendencia central.">
  <main>
    <Migas items={[{ texto: 'Inicio', href: base }, { texto: 'Laboratorio' }]} />
    <h1>Laboratorio</h1>
    <p>Cargá tus datos (uno por línea) y mirá cómo cambian la tabla, el gráfico y las medidas.</p>
    <Laboratorio client:load />
    <p><a href={base}>Volver al inicio</a>.</p>
  </main>
</Layout>
