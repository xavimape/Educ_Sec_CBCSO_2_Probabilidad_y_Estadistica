---
import Layout from '../layouts/Layout.astro';
import Migas from '../components/Migas.astro';
import Acordeon from '../components/Acordeon.tsx';
import Tabs from '../components/Tabs.tsx';
import Colapsable from '../components/Colapsable.tsx';
import PasosConstruccion from '../components/PasosConstruccion.tsx';
import Comparativa from '../components/Comparativa.tsx';
import AlertaConcepto from '../components/AlertaConcepto.tsx';
import '../styles/componentes.css';
import '../styles/kit.css';

const ejemplos = [
  { titulo: 'Ejemplo 1', contenido: 'Contenido de ejemplo 1.' },
  { titulo: 'Ejemplo 2', contenido: 'Contenido de ejemplo 2.' },
];
const base = import.meta.env.BASE_URL;
---

<Layout
  titulo="Componentes didácticos"
  descripcion="Vista previa interna de acordeones, tabs y colapsables."
>
  <main>
    <Migas items={[{ texto: 'Inicio', href: base }, { texto: 'Componentes' }]} />
    <h1>Componentes didácticos</h1>
    <p>Vista previa interna de los componentes de la Fase 5. No es una página de contenido para estudiantes.</p>

    <h2>Acordeón</h2>
    <Acordeon client:load titulo="Ver explicación detallada" contenido="Contenido de ejemplo del acordeón." />

    <h2>Tabs</h2>
    <Tabs client:load items={ejemplos} />

    <h2>Colapsable</h2>
    <Colapsable client:load contenido="Respuesta de ejemplo del colapsable." />

    <h2>Pasos de construcción</h2>
    <PasosConstruccion client:load pasos={['Trazá los ejes', 'Graduá la escala', 'Marcá la cuadrícula', 'Levantá las barras']} />

    <h2>Comparativa</h2>
    <Comparativa
      client:load
      error="Sumar los datos en lugar de multiplicar."
      acierto="Multiplicar 3 remeras × 2 pantalones = 6 conjuntos."
      explicacion="El principio de conteo multiplica las opciones de cada etapa."
    />

    <h2>Alerta de concepto</h2>
    <AlertaConcepto
      client:load
      titulo="¡Ojo!"
      texto="Un código numérico puede identificar una categoría: no siempre es una cantidad."
    />
  </main>
</Layout>
